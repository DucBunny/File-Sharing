              <option value="retreat">Retreat Weekend</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2"
              >Preferred Date</label
            >
            <input
              type="date"
              required
              class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-green-500 focus:outline-none"
            />
          </div>
          <button
            type="submit"
            class="w-full bg-green-600 hover:bg-green-700 text-white py-3 rounded-lg font-medium transition-colors"
          >
            Book Session
          </button>
        </form>
      </div>
    </div>

    <script>
      // Smooth scrolling for navigation links
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener("click", function (e) {
          e.preventDefault();
          const target = document.querySelector(this.getAttribute("href"));
          if (target) {
            target.scrollIntoView({
              behavior: "smooth",
              block: "start",
            });
          }
        });
      });

      // Booking modal functions
      function openBooking() {
        document.getElementById("bookingModal").classList.add("active");
        document.body.style.overflow = "hidden";
      }

      function closeBooking() {
        document.getElementById("bookingModal").classList.remove("active");
        document.body.style.overflow = "auto";
      }

      // Handle booking form submission
      function handleBooking(event) {
        event.preventDefault();
        alert(
          "Thank you for your booking request! We will contact you soon to confirm your session."
        );
        closeBooking();
        event.target.reset();
      }

      // Handle contact form submission
      function handleContactForm(event) {
        event.preventDefault();
        alert("Thank you for your message! We will get back to you soon.");
        event.target.reset();
      }

      // Show program details
      function showProgramDetails(program) {
        const programs = {
          physical:
            "Our Physical Therapy program focuses on restoring your body's natural balance through therapeutic movement and personalized treatment plans.",
          wellness:
            "Wellness & Mindfulness sessions help you find inner peace through meditation, breathing exercises, and mindful practices.",
          art: "Art & Creative Therapy allows you to express and heal through various artistic mediums in a supportive environment.",
          retreat:
            "Our Retreat Weekends offer immersive experiences for deep transformation and renewal away from daily stress.",
        };

        alert(programs[program] || "Program details coming soon!");
      }

      // Close modal when clicking outside
      document
        .getElementById("bookingModal")
        .addEventListener("click", function (e) {
          if (e.target === this) {
            closeBooking();
          }
        });

      // Add scroll effect to navigation
      window.addEventListener("scroll", function () {
        const nav = document.querySelector("nav");
        if (window.scrollY > 100) {
          nav.classList.add("shadow-lg");
        } else {
          nav.classList.remove("shadow-lg");
        }
      });
    </script>
